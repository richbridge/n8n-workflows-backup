    {
      "parameters": {
        "jsCode": "// 获取上一步提取的文本内容，请根据实际情况调整字段名\nconst pdfText = $input.first().json.data; \n\n// 1. 定义章节分隔符（请替换为你 PDF 中的章节标题格式）\n// 例如：按 \"Chapter 1\"、\"Chapter 2\" 或 \"第1章\"、\"第2章\" 进行分割\nconst chapterRegex = /(?=Chapter \\d+|(?=第\\d+章))/g; \n\n// 2. 执行拆分\n// 思路：先识别所有章节标题的位置，然后将文本切块\nconst chapters = [];\nlet lastIndex = 0;\nlet match;\n\n// 重置正则表达式\nconst regex = new RegExp(chapterRegex.source, 'g');\n\n// 查找所有章节标题\nwhile ((match = regex.exec(pdfText)) !== null) {\n    if (lastIndex !== 0) {\n        const content = pdfText.substring(lastIndex, match.index);\n        chapters.push({ content: content.trim() });\n    }\n    lastIndex = match.index;\n}\n// 添加最后一个章节\nif (lastIndex < pdfText.length) {\n    chapters.push({ content: pdfText.substring(lastIndex).trim() });\n}\n\n// 3. 输出结果，每个章节作为独立的 item\nreturn chapters.map((chapter, index) => ({\n    json: {\n        chapterNumber: index + 1,\n        content: chapter.content\n    }\n}));"
      },
